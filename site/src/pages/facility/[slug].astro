---
import Base from '../../layouts/Base.astro';
import facilities from '../../data/facilities.json';
import ALLF from '../../data/facilities.json';
export function getStaticPaths() {
  return facilities.map(f => ({ params: { slug: f.slug }, props: { f } }));
}
const { f } = Astro.props;
const hx = [...f.slug].reduce((a, c) => (a * 31 + c.charCodeAt(0)) % 997, 7);
const addr = `${f.street}, ${f.city}, ${f.state} ${f.zip}`;
const tipoTxt = f.usps ? 'This post office' : 'This facility';
const leads = [
  `Accepts new passport applications (Form DS-11) in ${f.city}, ${f.stateName}. Listed in the U.S. Department of State's official facility database, with phone, hours and services below.`,
  `${tipoTxt} is one of the official locations in ${f.city}, ${f.stateName} where you can submit a first-time passport application in person — verified against the State Department's facility database.`,
  `Applying for a passport in ${f.city}? ${f.name} appears in the State Department's official list of acceptance facilities. Phone, address, passport hours and photo availability below.`,
  `An official passport acceptance point serving ${f.city}, ${f.stateName}: here you can execute Form DS-11 for first-time applicants and children under 16. Details from State Department data.`,
  `${f.name} handles in-person passport applications for the ${f.city} area. Its listing in the official State Department database includes the contact details and services shown here.`,
  `One of ${f.city}'s official acceptance facilities for U.S. passport applications. Below: direct phone, passport window hours and what to bring, sourced from the State Department's locator.`
];
const lead = leads[hx % 6];
const mapQ = encodeURIComponent(`${f.name}, ${addr}`);
const near = facilities.filter(x => x.citySlug === f.citySlug && x.stateSlug === f.stateSlug && x.slug !== f.slug).slice(0, 5);
const __k = (x) => `${x.name}|${x.city}|${x.state}`;
const __rep = ALLF.filter((x) => __k(x) === __k(f)).length > 1;
const lugar = `${f.city}, ${f.state}` + (__rep && f.street ? ` (${f.street.replace(/\s+/g, ' ').trim()})` : '');
const title = [`${f.name} — Passport Acceptance Facility in ${lugar}`, `${f.name} — Passport Office in ${lugar}`, `${f.name}, ${lugar}: Passports`, `${f.name}, ${lugar}`].find((x) => x.length <= 70) || `${f.name}, ${lugar}`;
const desc = `${f.name} in ${f.city}, ${f.state}: phone ${f.phone}, address ${f.street}, hours, ${f.photoOnsite ? 'on-site passport photos, ' : ''}and how to apply. From the official State Department facility list.`;
const DAYS = ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'];
const dayHours = DAYS.map(d => {
  const g = f.hours.find(h => h.d.includes(d.slice(0,3)) || (h.d.includes('\u2013') && DAYS.indexOf(d) >= DAYS.indexOf(h.d.split('\u2013')[0]) && DAYS.indexOf(d) <= DAYS.indexOf(h.d.split('\u2013')[1])));
  return { day: d, txt: g ? g.h : 'Closed / not listed' };
});
const hoursSpec = f.hours.length ? { "openingHoursSpecification": dayHours.filter(x => x.txt !== 'Closed / not listed').map(x => { const m = x.txt.match(/(\d+):(\d+) (AM|PM) \u2013 (\d+):(\d+) (PM|AM)/); if (!m) return null; const h24 = (h, ap) => String(ap === 'PM' && +h < 12 ? +h + 12 : +h).padStart(2, '0'); return { "@type":"OpeningHoursSpecification", "dayOfWeek": x.day, "opens": `${h24(m[1], m[3])}:${m[2]}`, "closes": `${h24(m[4], m[6])}:${m[5]}` }; }).filter(Boolean) } : {};
const schema = { "@context":"https://schema.org","@type":"GovernmentOffice","name":f.name,
  "address":{"@type":"PostalAddress","streetAddress":f.street,"addressLocality":f.city,"addressRegion":f.state,"postalCode":f.zip,"addressCountry":"US"},
  "telephone":f.phone,...hoursSpec,"url":new URL(Astro.url.pathname, Astro.site).href };
const faq = [
  { q:`Do I need an appointment at ${f.name}?`, a: f.note || `Many acceptance facilities take walk-ins, but policies vary by location. Call ${f.phone} to confirm whether this facility requires an appointment before you visit.` },
  { q:`Can I get passport photos here?`, a: f.photoOnsite ? `Yes — this facility offers on-site passport photo service (fee applies, typically around $15). You can also bring your own compliant 2x2 photo.` : (f.photoNearby ? `This facility does not take photos on site, but photo services are available nearby (pharmacies and shipping stores). Bring a compliant 2x2 photo with you.` : `Photo service is not listed for this location — bring a compliant 2x2 passport photo with you.`) },
  { q:`What should I bring?`, a:`Completed Form DS-11 (do not sign it beforehand), proof of U.S. citizenship plus a photocopy, valid photo ID plus a photocopy, one passport photo, and payment: the application fee by check or money order to "U.S. Department of State" and the $35 execution fee paid separately to the facility.` },
  { q:`How much does it cost?`, a:`For a first-time adult passport book: $130 application fee + $35 execution fee = $165 total. Minors under 16: $100 + $35. Add $60 for expedited processing. See our full fee breakdown for cards, renewals and delivery options.` }
];
const schemaFaq = { "@context":"https://schema.org","@type":"FAQPage","mainEntity":faq.map(x => ({"@type":"Question","name":x.q,"acceptedAnswer":{"@type":"Answer","text":x.a}})) };
const crumbs = {"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
  {"@type":"ListItem","position":1,"name":"Home","item":"https://passportofficefinder.com/"},
  {"@type":"ListItem","position":2,"name":f.stateName,"item":`https://passportofficefinder.com/${f.stateSlug}/`},
  {"@type":"ListItem","position":3,"name":f.city,"item":`https://passportofficefinder.com/${f.stateSlug}/${f.citySlug}/`},
  {"@type":"ListItem","position":4,"name":f.name}]};
---
<Base title={title} desc={desc} schema={schema}>
<main class="wrap">
  <div class="crumbs"><a href="/">Home</a> › <a href={`/${f.stateSlug}/`}>{f.stateName}</a> › <a href={`/${f.stateSlug}/${f.citySlug}/`}>{f.city}</a> › {f.name}</div>
  <p class="kicker">{f.usps ? 'USPS Post Office · ' : ''}Official passport acceptance facility</p>
  <h1 style="font-size:1.7rem">{f.name}</h1>
  <p class="lead">{lead}</p>
  <div class="btns">
    <a class="btn" href={`/${f.stateSlug}/${f.citySlug}/`}><i class="fa-solid fa-city"></i> More offices in {f.city}</a>
    <a class="btn alt" href="/passport-fees/"><i class="fa-solid fa-dollar-sign"></i> 2026 fees</a>
    <a class="btn ghost" href="/passport-appointment/"><i class="fa-solid fa-calendar-check"></i> How appointments work</a>
  </div>

  <h2 style="margin-top:1.6rem">Before you visit</h2>
  <div class="cols2">
    <a class="row" href={f.usps && f.website ? (f.website.startsWith('http') ? f.website : `https://${f.website}`) : '/passport-appointment/'} rel={f.usps ? 'nofollow noopener' : undefined} target={f.usps ? '_blank' : undefined}><h3><i class="fa-solid fa-calendar-check" style="color:var(--gold2)"></i> {f.usps ? 'Book on the USPS scheduler' : 'Check appointment rules'}</h3><p class="sub">{f.usps ? 'This location books passport slots online — direct link.' : 'Some facilities take walk-ins; one call settles it.'}</p></a>
    <a class="row" href="/talk-to-a-real-person/"><h3><i class="fa-solid fa-headset" style="color:var(--gold2)"></i> Talk to a real person</h3><p class="sub">The shortcut through the passport line's phone menu (NPIC).</p></a>
    <a class="row" href="#checklist"><h3><i class="fa-solid fa-list-check" style="color:var(--gold2)"></i> What to bring</h3><p class="sub">DS-11 unsigned, evidence, ID, photo, two payments — the checklist.</p></a>
    <a class="row" href="/passport-fees/"><h3><i class="fa-solid fa-dollar-sign" style="color:var(--gold2)"></i> Exact 2026 fees</h3><p class="sub">$165 first adult book all-in. Full table, who pays what to whom.</p></a>
  </div>

  <iframe class="map" loading="lazy" src={`https://www.google.com/maps?q=${mapQ}&z=15&output=embed`} title={`Map: ${f.name}`}></iframe>
  <div class="btns"><a class="btn ghost" href={`https://www.google.com/maps/dir/?api=1&destination=${mapQ}`} rel="nofollow noopener" target="_blank"><i class="fa-solid fa-diamond-turn-right"></i> Get directions</a></div>

  <div class="panel gold">
    <div class="tags" style="margin:0 0 12px">
      {f.accessible && <span class="tag green"><i class="fa-solid fa-wheelchair"></i> Accessible</span>}
      {f.photoOnsite && <span class="tag gold"><i class="fa-solid fa-camera"></i> Photos on-site</span>}
      {!f.photoOnsite && f.photoNearby && <span class="tag">Photos nearby</span>}
      {f.usps && <span class="tag">USPS</span>}
    </div>
    <div class="kv">
      <b>Address</b><span>{addr}</span>
      <b>Phone</b><span><a href={`tel:+1${f.phone.replace(/\D/g,'')}`}>{f.phone}</a></span>
      {f.website && <><b>Scheduling</b><span><a href={f.website.startsWith('http') ? f.website : `https://${f.website}`} rel="nofollow noopener" target="_blank">{f.website.replace(/^https?:\/\//,'').slice(0,50)}</a></span></>}
      {f.hours.length > 0 && <><b>Passport hours</b><span><table style="border-collapse:collapse;font-size:.92rem">{dayHours.map(x => <tr data-day={x.day}><td style="padding:1px 14px 1px 0;font-weight:600">{x.day}</td><td>{x.txt}</td></tr>)}</table></span></>}
    </div>
    {f.note && <p style="margin:12px 0 0;font-size:.9rem;color:#5a6472"><i class="fa-solid fa-circle-info" style="color:var(--gold2)"></i> {f.note}</p>}
    <p style="margin:10px 0 0;font-size:.83rem;color:var(--mut)">Source: U.S. Department of State facility locator. Confirm hours by phone — passport windows often differ from general business hours.</p>
  </div>

  <h2>Busy and quiet times</h2>
  <ul>
    <li><strong>Quietest:</strong> mid-morning and mid-afternoon, Tuesday to Thursday{f.usps ? ' — and scheduler slots released for those windows go last' : ''}.</li>
    <li><strong>Busiest:</strong> Mondays, lunchtime, Saturdays{f.hours.some(h => h.d.includes('Sat')) ? ' (this location has Saturday passport hours — expect lines)' : ''}, and January through summer as travel season peaks.</li>
    <li><strong>Rule of thumb:</strong> passport windows close intake before posted closing when the day's capacity fills — earlier in your visit beats later.</li>
  </ul>
  <h2 id="checklist">{['Before you go: 60-second checklist', 'What to bring: the 60-second checklist', `Applying at ${f.name}: quick checklist`, 'Your visit, prepared in 60 seconds'][hx % 4]}</h2>
  <ol>
    <li><strong>Form DS-11</strong> filled out but <em>unsigned</em> — you sign in front of the acceptance agent.</li>
    <li><strong>Citizenship evidence</strong> (birth certificate or old passport) + a photocopy on plain paper.</li>
    <li><strong>Photo ID</strong> (driver's license) + photocopy.</li>
    <li><strong>One 2x2 photo</strong>{f.photoOnsite ? ' — or have it taken here on-site.' : '.'}</li>
    <li><strong>Two payments:</strong> application fee by check or money order to "U.S. Department of State", and the $35 execution fee to the facility. <a href="/passport-fees/">Full fee table</a>.</li>
  </ol>
  <div class="note"><strong>{['Renewing?', 'Already had a passport?', 'Adult renewal?'][hx % 3]}</strong> Most adult renewals skip the acceptance facility entirely — you can renew by mail or online for $130 with no execution fee. Facilities are for first-time applicants, children under 16, and replacements after loss.</div>

  <h2>Frequently asked questions</h2>
  {faq.map(x => <details class="fq"><summary>{x.q}</summary><div><p>{x.a}</p></div></details>)}

  {near.length > 0 && <>
    <h2>Other facilities in {f.city}</h2>
    <div class="rowlist">
      {near.map(n => <a class="row" href={`/facility/${n.slug}/`}><h3>{n.name}</h3><p class="sub">{n.street} · {n.phone}</p></a>)}
    </div>
  </>}

  <h2>Related guides</h2>
  <div class="cols2">
    <a class="row" href="/expedited-passport/"><h3><i class="fa-solid fa-bolt" style="color:var(--gold2)"></i> Expedited passport</h3><p class="sub">+$60 for 2-3 weeks, or same-day agency routes.</p></a>
    <a class="row" href="/how-long-does-a-passport-take/"><h3><i class="fa-solid fa-hourglass-half" style="color:var(--gold2)"></i> Processing times</h3><p class="sub">Door-to-door timelines for every route.</p></a>
    <a class="row" href="/passport-at-the-post-office/"><h3><i class="fa-solid fa-envelope" style="color:var(--gold2)"></i> Post office passports</h3><p class="sub">How the USPS system works, step by step.</p></a>
    <a class="row" href="/walk-in-passport/"><h3><i class="fa-solid fa-person-walking" style="color:var(--gold2)"></i> Walk-in offices</h3><p class="sub">Where no appointment is needed.</p></a>
  </div>
  <div class="src">Independent site, not affiliated with the State Department or USPS. Facility details come from the official public locator and can change — verify with the facility.</div>
</main>
<script>const d = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'][new Date().getDay()]; const r = document.querySelector(`tr[data-day="${d}"]`); if (r) { r.style.background = '#f5ecd7'; r.style.fontWeight = '700'; r.firstElementChild.textContent = d + ' (today)'; }</script>
<script type="application/ld+json" set:html={JSON.stringify(schemaFaq)} />
<script type="application/ld+json" set:html={JSON.stringify(crumbs)} />
</Base>
