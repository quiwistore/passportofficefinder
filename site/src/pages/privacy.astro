---
import L from '../data/legal.json';
import LS from '../data/contacto.json';
import Base from '../layouts/Base.astro';
---
<Base title="Privacy Policy | Passport Office Finder" desc="Privacy policy for passportofficefinder.com.">
<main class="wrap">
  <h1 style="font-size:1.7rem">Privacy policy</h1>
<Fragment set:html={L['privacy'].html.replaceAll('{{EMAIL}}', LS.email)} />
</main>
</Base>
