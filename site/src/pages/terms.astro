---
import L from '../data/legal.json';
import LS from '../data/contacto.json';
import Base from '../layouts/Base.astro';
---
<Base title="Terms of Use | Passport Office Finder" desc="Terms of use of Passport Office Finder, an independent, unofficial site about U.S. passport acceptance facilities.">
<main class="wrap">
  <h1 style="font-size:1.7rem">Terms of use</h1>
<Fragment set:html={L['terms'].html.replaceAll('{{EMAIL}}', LS.email)} />
</main>
</Base>
